/* Bound Apps Script, V8. Keep spreadsheet and Script Properties private. */
const ARENA_GAMES=['drones','planes','fighters','towers','cyber','maze','race','forest','runner','builder','siege','expedition','parkour','lighthouse','voxel','alchemy','capsule'];
const ARENA_SUBJECTS=['math','physics','chemistry','biology','geography','informatics','natural-science','russian','english','kazakhstan-history','world-history','kazakh','world-around','literacy','literary-reading','music-primary','visual-art','handicraft'];
const SCHEMA={Users:['id','login','display','salt','verifier','created','disabled','grade','lastName','firstName'],Sessions:['tokenHash','userId','expires'],Rounds:['id','userId','started','game','subject','grade','topic','profileGrade','reward'],Scores:['id','userId','roundId','seq','game','subject','correct','points','created','eventAt','profileGrade','taskGrade','percent'],Leaderboard:['rank','playerId','display','points','correct','grade'],MonthlyWinners:['month','playerId','lastName','firstName','grade','points','achievedAt','closedAt','status']};
// Editor-only initialization. Never exposed as a web API action.
function setup(){
 const props=PropertiesService.getScriptProperties();
 const saved=props.getProperty('SPREADSHEET_ID');
 const book=saved?SpreadsheetApp.openById(saved):(SpreadsheetApp.getActiveSpreadsheet()||SpreadsheetApp.create('Учебная арена — аккаунты и рейтинг'));
 const oldUsers=book.getSheetByName('Users');
 if(!props.getProperty('AUTH_PEPPER')&&oldUsers&&oldUsers.getLastRow()>1)throw Error('В базе уже есть аккаунты, но отсутствует AUTH_PEPPER. Восстановите прежнее свойство скрипта; новый секрет изменит проверку старых паролей.');
 props.setProperty('SPREADSHEET_ID',book.getId());
 if(!props.getProperty('AUTH_PEPPER'))props.setProperty('AUTH_PEPPER',random_()+random_());
 Object.keys(SCHEMA).forEach(name=>{
  const sheet=book.getSheetByName(name)||book.insertSheet(name),headers=SCHEMA[name];
  if(!sheet.getLastRow())sheet.appendRow(headers);
  else{const current=sheet.getRange(1,1,1,headers.length).getValues()[0];current.forEach((v,i)=>{if(v!==''&&v!==headers[i])throw Error('Заголовки листа '+name+' отличаются от ожидаемых. Не меняйте их вручную.');});sheet.getRange(1,1,1,headers.length).setValues([headers]);}
  sheet.setFrozenRows(1);
 });
 props.setProperty('SCHEMA_VERSION','3');if(!props.getProperty('CONTEST_NEXT_MONTH'))props.setProperty('CONTEST_NEXT_MONTH',monthKey_(Date.now()));refreshLeaderboard_();installMonthlyTrigger_();
 const url=book.getUrl();console.log('База настроена: '+url);return{ready:true,spreadsheetUrl:url};
}
function serverInfo_(){const p=PropertiesService.getScriptProperties(),ready=!!p.getProperty('SPREADSHEET_ID')&&!!p.getProperty('AUTH_PEPPER')&&p.getProperty('SCHEMA_VERSION')==='3';return{service:'arena-mobile',version:3,ready,monthlyAutomatic:p.getProperty('MONTHLY_TRIGGER_READY')==='true',message:ready?'База подключена.':'Владелец должен один раз выполнить setup в этом проекте Apps Script и предоставить доступ к Google Таблицам.'}}
function db_(){const p=PropertiesService.getScriptProperties(),id=p.getProperty('SPREADSHEET_ID');if(!id||p.getProperty('SCHEMA_VERSION')!=='3')fail_('База ещё не инициализирована. Откройте этот проект Apps Script, выберите setup и нажмите «Выполнить». Одной ссылки /exec недостаточно.','SETUP');return SpreadsheetApp.openById(id)}
function grade_(value){if(!Number.isInteger(value)||value<1||value>11)fail_('Выберите свой класс от 1 до 11.','GRADE_REQUIRED');return value}
function reward_(profileGrade,taskGrade){const delta=Math.abs(grade_(profileGrade)-grade_(taskGrade));return delta===0?10:Math.max(1,6-delta)}
function rows_(n){const s=db_().getSheetByName(n);if(!s)fail_('Сервис ещё не настроен.','SETUP');return s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,SCHEMA[n].length).getValues():[]}
function append_(n,rows){if(!rows.length)return;const s=db_().getSheetByName(n);s.getRange(s.getLastRow()+1,1,rows.length,SCHEMA[n].length).setValues(rows)}
function random_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'')}
function hex_(a){return a.map(x=>('0'+((x+256)%256).toString(16)).slice(-2)).join('')}
function hash_(t){return hex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(t),Utilities.Charset.UTF_8))}
function pepper_(t){const k=PropertiesService.getScriptProperties().getProperty('AUTH_PEPPER');if(!k)fail_('Сервис ещё не настроен.','SETUP');return hex_(Utilities.computeHmacSha256Signature(String(t),k))}
function equal_(a,b){a=String(a);b=String(b);let r=a.length^b.length;for(let i=0;i<Math.max(a.length,b.length);i++)r|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return r===0}
function fail_(message,code){const e=new Error(message);e.publicCode=code||'INPUT';throw e}
function login_(v){const s=String(v||'').toLowerCase().trim();if(!/^[a-z][a-z0-9_]{2,23}$/.test(s))fail_('Логин: 3–24 латинских символа, цифры и _. Начните с буквы.');return s}
function rate_(key,max,seconds){const c=CacheService.getScriptCache(),k='rate:'+hash_(key),n=Number(c.get(k)||0);if(n>=max)fail_('Слишком много попыток. Подождите несколько минут.','RATE');c.put(k,String(n+1),seconds)}
function user_(id){return rows_('Users').find(u=>u[0]===id&&!u[6])}
function session_(token){if(typeof token!=='string'||!/^[a-f0-9]{128}$/.test(token))fail_('Войдите ещё раз.','AUTH');const digest=hash_(token),s=rows_('Sessions').find(r=>r[0]===digest&&Number(r[2])>Date.now()),u=s&&user_(s[1]);if(!u)fail_('Сеанс истёк. Войдите ещё раз.','AUTH');return{user:u,hash:digest}}
function name_(value,label){const s=String(value||'').trim().replace(/\s+/g,' ').normalize('NFC');if(!/^[\p{L}][\p{L}\p{M}'’ -]{1,39}$/u.test(s))fail_('Введите '+label+': от 2 до 40 букв.','PROFILE_REQUIRED');return s}
function hasNames_(u){return !!u[8]&&!!u[9]}
function display_(u){return hasNames_(u)?String(u[8])+' '+String(u[9]):String(u[2])}
function profile_(u,scores){const own=(scores||rows_('Scores')).filter(r=>r[1]===u[0]),grade=Number.isInteger(Number(u[7]))&&Number(u[7])>=1&&Number(u[7])<=11?Number(u[7]):null,bounds=monthBounds_(monthKey_(Date.now()));return{id:u[0],display:display_(u),lastName:String(u[8]||''),firstName:String(u[9]||''),needsProfile:!grade||!hasNames_(u),points:own.reduce((sum,r)=>sum+Number(r[7]),0),monthPoints:own.filter(r=>Number(r[8])>=bounds.start&&Number(r[8])<bounds.end).reduce((sum,r)=>sum+Number(r[7]),0),correct:own.filter(r=>r[6]===true||r[6]==='true').length,grade}}
function issue_(u){const token=random_()+random_();append_('Sessions',[[hash_(token),u[0],Date.now()+7*86400000]]);return{token,user:profile_(u),apiVersion:3}}
const CONTEST_TZ='Asia/Qyzylorda';
function monthKey_(at){return Utilities.formatDate(new Date(at),CONTEST_TZ,'yyyy-MM')}
function nextMonth_(month){const [y,m]=month.split('-').map(Number);return String(m===12?y+1:y)+'-'+String(m===12?1:m+1).padStart(2,'0')}
function monthBounds_(month){return{start:Utilities.parseDate(month+'-01 00:00:00',CONTEST_TZ,'yyyy-MM-dd HH:mm:ss').getTime(),end:Utilities.parseDate(nextMonth_(month)+'-01 00:00:00',CONTEST_TZ,'yyyy-MM-dd HH:mm:ss').getTime()}}
function rankPlayers_(users,scores,month){const bounds=month?monthBounds_(month):null,totals=new Map();for(const r of scores){const at=Number(r[8]);if(bounds&&(at<bounds.start||at>=bounds.end))continue;const t=totals.get(r[1])||{points:0,correct:0,lastAwardAt:0};t.points+=Number(r[7]);if(r[6]===true||r[6]==='true')t.correct++;if(Number(r[7])>0)t.lastAwardAt=Math.max(t.lastAwardAt,at);totals.set(r[1],t)}return users.filter(u=>!u[6]&&hasNames_(u)&&Number(u[7])>=1&&Number(u[7])<=11).map(u=>({id:u[0],display:display_(u),lastName:String(u[8]),firstName:String(u[9]),grade:Number(u[7]),...(totals.get(u[0])||{points:0,correct:0,lastAwardAt:0})})).sort((a,b)=>b.points-a.points||a.lastAwardAt-b.lastAwardAt||a.id.localeCompare(b.id)).map((p,i)=>({...p,rank:i+1}))}
function leaderboard_(){return rankPlayers_(rows_('Users'),rows_('Scores'),null)}
function refreshLeaderboard_(){const players=leaderboard_(),s=db_().getSheetByName('Leaderboard');if(s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,6).clearContent();if(players.length)s.getRange(2,1,players.length,6).setValues(players.map(p=>[p.rank,p.id,p.display,p.points,p.correct,p.grade]));return players}
function closeDueMonths_(asOf=Date.now()){const p=PropertiesService.getScriptProperties(),current=monthKey_(asOf);let month=p.getProperty('CONTEST_NEXT_MONTH')||current;if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(month))fail_('Проверьте CONTEST_NEXT_MONTH в настройках скрипта.','SETUP');const closed=new Set(rows_('MonthlyWinners').map(r=>r[0]));let count=0;while(month<current&&count<24){if(!closed.has(month)){const winner=rankPlayers_(rows_('Users'),rows_('Scores'),month).find(p=>p.points>0);append_('MonthlyWinners',[[month,winner?winner.id:'',winner?winner.lastName:'',winner?winner.firstName:'',winner?winner.grade:'',winner?winner.points:0,winner?winner.lastAwardAt:0,asOf,winner?'winner':'no_results']]);closed.add(month)}month=nextMonth_(month);p.setProperty('CONTEST_NEXT_MONTH',month);count++}return count}
function winners_(){return rows_('MonthlyWinners').map(r=>({month:String(r[0]),id:String(r[1]),lastName:String(r[2]),firstName:String(r[3]),display:r[1]?String(r[2])+' '+String(r[3]):'',grade:Number(r[4])||null,points:Number(r[5]),achievedAt:Number(r[6]),closedAt:Number(r[7]),status:r[8]})).sort((a,b)=>b.month.localeCompare(a.month)).slice(0,24)}
function leaderboardResponse_(period){closeDueMonths_();const month=monthKey_(Date.now()),players=period==='all'?leaderboard_():rankPlayers_(rows_('Users'),rows_('Scores'),month),winners=winners_();return{players:players.slice(0,100),period:period==='all'?'all':month,month,winners,leader:players.find(p=>p.points>0)||null,latestWinner:winners[0]||null,updatedAt:Date.now()}}
function installMonthlyTrigger_(){if(!ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='closeMonthlyLeaderboard'))ScriptApp.newTrigger('closeMonthlyLeaderboard').timeBased().onMonthDay(1).atHour(1).nearMinute(5).inTimezone(CONTEST_TZ).create();PropertiesService.getScriptProperties().setProperty('MONTHLY_TRIGGER_READY','true')}
// Editor/owner timer only. No web route can choose or replace a winner.
function closeMonthlyLeaderboard(){const lock=LockService.getScriptLock();if(!lock.tryLock(30000))return;try{return closeDueMonths_()}finally{lock.releaseLock()}}
function route_(d){const now=Date.now();if(d.action==='serverInfo')return serverInfo_();
 if(d.action==='challenge'){const login=login_(d.login);rate_('challenge:'+login,30,300);const u=rows_('Users').find(r=>r[1]===login);return{salt:u?u[3]:pepper_('unknown:'+login).slice(0,32),iterations:600000}}
 if(d.action==='register'){rate_('register-global',200,3600);const login=login_(d.login),lastName=name_(d.lastName,'фамилию'),firstName=name_(d.firstName,'имя'),display=lastName+' '+firstName,schoolGrade=grade_(d.grade);if(!Number.isInteger(d.passwordLength)||d.passwordLength<6||d.passwordLength>128)fail_('Пароль должен содержать от 6 до 128 символов.');if(!/^[a-f0-9]{32}$/.test(d.salt||'')||!/^[a-f0-9]{64}$/.test(d.proof||''))fail_('Некорректная регистрация.');if(rows_('Users').some(u=>u[1]===login))fail_('Этот логин уже занят.');const u=[random_().slice(0,24),login,display,d.salt,pepper_(login+':'+d.proof),now,false,schoolGrade,lastName,firstName];append_('Users',[u]);return issue_(u)}
 if(d.action==='login'){const login=login_(d.login);rate_('login:'+login,8,300);const u=rows_('Users').find(r=>r[1]===login&&!r[6]);if(!/^[a-f0-9]{64}$/.test(d.proof||'')||!equal_(u?u[4]:pepper_('fake'),pepper_(login+':'+d.proof)))fail_('Неверный логин или пароль.','LOGIN');return issue_(u)}
 if(d.action==='leaderboard')return leaderboardResponse_(d.period);
 const auth=session_(d.token),u=auth.user;
 if(d.action==='me')return profile_(u);
 if(d.action==='completeProfile'){if(hasNames_(u)&&profile_(u).grade)fail_('Профиль уже заполнен. Для изменения обратитесь к учителю.');const savedGrade=profile_(u).grade,selected=savedGrade||grade_(d.grade);if(savedGrade&&d.grade!==undefined&&Number(d.grade)!==savedGrade)fail_('Класс уже закреплён за аккаунтом.');const lastName=hasNames_(u)?String(u[8]):name_(d.lastName,'фамилию'),firstName=hasNames_(u)?String(u[9]):name_(d.firstName,'имя'),index=rows_('Users').findIndex(row=>row[0]===u[0]);u[7]=selected;u[8]=lastName;u[9]=firstName;u[2]=lastName+' '+firstName;db_().getSheetByName('Users').getRange(index+2,1,1,SCHEMA.Users.length).setValues([u]);return profile_(u);}
 if(d.action==='setGrade'){if(profile_(u).grade)fail_('Класс уже закреплён за аккаунтом. Для изменения обратитесь к учителю.');const selected=grade_(d.grade),users=rows_('Users'),index=users.findIndex(row=>row[0]===u[0]);db_().getSheetByName('Users').getRange(index+2,8).setValue(selected);u[7]=selected;return profile_(u);}
 if(d.action==='logout'){const s=db_().getSheetByName('Sessions');rows_('Sessions').forEach((r,i)=>{if(r[0]===auth.hash)s.getRange(i+2,3).setValue(0)});return{loggedOut:true}}
 if(d.action==='startRound'){rate_('start:'+u[0],60,600);if(!ARENA_GAMES.includes(d.game)||!ARENA_SUBJECTS.includes(d.subject)||!Number.isInteger(d.grade)||d.grade<1||d.grade>11)fail_('Игра или предмет не поддерживаются.');if(!hasNames_(u))fail_('Заполните фамилию и имя в профиле.','PROFILE_REQUIRED');const profileGrade=grade_(profile_(u).grade),reward=reward_(profileGrade,d.grade),id=random_().slice(0,32);append_('Rounds',[[id,u[0],now,d.game,d.subject,d.grade,Math.max(0,Math.min(500,Number(d.topic)||0)),profileGrade,reward]]);return{roundId:id,serverNow:now,reward,percent:reward*10,profileGrade,taskGrade:d.grade}}
 if(d.action==='score'){if(!Array.isArray(d.events)||!d.events.length||d.events.length>20)fail_('Некорректный пакет.');const rounds=rows_('Rounds'),scores=rows_('Scores'),ids=new Set(scores.map(r=>r[0])),processed=[],out=[],times=scores.filter(r=>r[1]===u[0]&&Number(r[7])>0).map(r=>Number(r[9]));let limited=false;
  for(const e of d.events){if(!/^[a-f0-9]{32}$/.test(e.roundId||'')||!Number.isInteger(e.seq)||e.seq<1||e.seq>10000||!Number.isInteger(e.elapsed)||e.elapsed<0||typeof e.correct!=='boolean')fail_('Некорректный результат.');const key=e.roundId+':'+e.seq,id=u[0]+':'+key;processed.push(key);if(ids.has(id))continue;const r=rounds.find(r=>r[0]===e.roundId&&r[1]===u[0]);if(!r)fail_('Игровая сессия не найдена.');const profileGrade=Number(r[7])||grade_(profile_(u, scores).grade),taskGrade=grade_(Number(r[5])),reward=reward_(profileGrade,taskGrade);const at=Number(r[2])+e.elapsed;if(at>now+2500||e.elapsed>45*60000)fail_('Некорректное время результата.');if(now-Number(r[2])>7*86400000){limited=true;continue}let points=0;if(e.correct){if(times.every(t=>Math.abs(at-t)>=5000)){points=reward;times.push(at)}else limited=true}out.push([id,u[0],e.roundId,e.seq,r[3],r[4],e.correct,points,now,at,profileGrade,taskGrade,reward*10]);ids.add(id)}
  const acceptedAt=Date.now();out.forEach(row=>row[8]=acceptedAt);closeDueMonths_(acceptedAt);append_('Scores',out);refreshLeaderboard_();return{processed,user:profile_(u,scores.concat(out)),limited};
 }
 fail_('Неизвестное действие.');
}
function doPost(e){const lock=LockService.getScriptLock();let held=false;try{if(!e||!e.postData||e.postData.contents.length>32768)fail_('Слишком большой запрос.');const d=JSON.parse(e.postData.contents);if(!d||typeof d!=='object'||Array.isArray(d))fail_('Некорректный запрос.');held=lock.tryLock(15000);if(!held)fail_('Сервис занят. Повторите отправку.','BUSY');return json_({ok:true,data:route_(d)})}catch(e){return json_({ok:false,code:e.publicCode||'SERVER',error:e.publicCode?e.message:'Сервис временно недоступен.'})}finally{if(held)lock.releaseLock()}}
function doGet(){return json_({ok:true,data:serverInfo_()})}
function json_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON)}
